<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/tiny_margin"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="@dimen/small_margin"
    android:paddingBottom="@dimen/small_margin"
    android:paddingEnd="@dimen/medium_margin">

    <View
        android:id="@+id/indent_view"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true" />

    <ImageView
        android:id="@+id/tree_expand_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_toEndOf="@id/indent_view"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/small_margin"
        android:padding="4dp"
        android:src="@drawable/ic_chevron_down_vector"
        android:visibility="gone" />

    <com.simplemobiletools.commons.views.MySquareImageView
        android:id="@+id/tree_thumbnail"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_toEndOf="@id/tree_expand_arrow"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/small_margin" />

    <com.simplemobiletools.commons.views.MyTextView
        android:id="@+id/tree_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/medium_margin"
        android:layout_toEndOf="@id/tree_thumbnail"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size" />

    <com.simplemobiletools.commons.views.MyTextView
        android:id="@+id/tree_media_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/medium_margin"
        android:alpha="0.6"
        android:textSize="@dimen/small_text_size" />

</RelativeLayout>